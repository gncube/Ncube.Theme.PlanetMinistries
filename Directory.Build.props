<Project>
  <PropertyGroup>
    <!-- Centralized Target Framework -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Centralized Versioning (Single Source of Truth) -->
    <VersionPrefix>2.0.1</VersionPrefix>

    <!-- Common Metadata -->
    <Authors>Gerald Ncube</Authors>
    <Company>Planet Ministries Ltd</Company>
    <Product>Ncube.Theme.PlanetMinistries</Product>
    <Copyright>Copyright © Planet Ministries Ltd</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gncube/Ncube.Theme.PlanetMinistries</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gncube/Ncube.Theme.PlanetMinistries.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>