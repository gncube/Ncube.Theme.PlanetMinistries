@namespace Ncube.Theme.PlanetMinistries.Containers
@inherits ModuleBase
@implements Oqtane.Interfaces.ISettingsControl
@inject ISettingService SettingService
@attribute [OqtaneIgnore]

<div class="container">
    <div class="row mb-3 align-items-center">
        <Label Class="col-sm-3 fw-semibold" For="displayTitle"
               HelpText="Specify if the module title should be displayed in the container header">Display Title?</Label>
        <div class="col-sm-9">
            <select id="displayTitle" class="form-select" @bind="@_showTitle">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>
    </div>
</div>

@code {
    private string _showTitle = "true";

    protected override void OnInitialized()
    {
        try
        {
            var ns = GetType().Namespace ?? "Ncube.Theme.PlanetMinistries.Containers";
            _showTitle = SettingService.GetSetting(ModuleState.Settings, $"{ns}:Title", "true");
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }

    public async Task UpdateSettings()
    {
        try
        {
            var ns = GetType().Namespace ?? "Ncube.Theme.PlanetMinistries.Containers";
            var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            settings = SettingService.SetSetting(settings, $"{ns}:Title", _showTitle);
            await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }
}