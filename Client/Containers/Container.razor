@namespace Ncube.Theme.PlanetMinistries.Containers
@inherits ContainerBase
@inject ISettingService SettingService
@using Oqtane.Themes.Controls

<div class="pm-container @(PageState.EditMode ? "pm-container-edit" : string.Empty) mb-4">
    @if (PageState.EditMode)
    {
        <div
            class="pm-container-admin-bar d-flex justify-content-between align-items-center bg-light border p-2 mb-2 rounded">
            <span class="fw-semibold small text-dark">
                <i class="bi bi-box me-1" aria-hidden="true"></i>@ModuleState.Title
            </span>
            <ModuleActions />
        </div>
    }
    else if (_showTitle && !string.IsNullOrEmpty(ModuleState.Title) && ModuleState.Title != "-")
    {
        <div class="pm-container-header mb-3">
            <h3 class="h5 fw-bold text-dark border-bottom pb-2">@ModuleState.Title</h3>
        </div>
    }

    <div class="pm-container-content">
        <ModuleInstance />
    </div>
</div>

@code {
    public override string Name => "Planet Ministries Standard Container";

    private bool _showTitle = true;

    protected override void OnParametersSet()
    {
        try
        {
            var ns = GetType().Namespace ?? "Ncube.Theme.PlanetMinistries.Containers";
            _showTitle = bool.Parse(SettingService.GetSetting(ModuleState.Settings, $"{ns}:Title", "true"));
        }
        catch
        {
            _showTitle = true;
        }
    }
}