@namespace Ncube.Theme.PlanetMinistries.Containers
@inherits ContainerBase
@inject ISettingService SettingService
@using Oqtane.Themes.Controls

<div class="card pm-card-container @(PageState.EditMode ? "pm-container-edit" : string.Empty) shadow-sm mb-4">
    @if (PageState.EditMode)
    {
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold small text-dark">
                <i class="bi bi-card-heading me-1" aria-hidden="true"></i>@ModuleState.Title
            </span>
            <ModuleActions />
        </div>
    }
    else if (_showTitle && !string.IsNullOrEmpty(ModuleState.Title) && ModuleState.Title != "-")
    {
        <div class="card-header bg-white border-bottom py-3">
            <h4 class="h6 text-uppercase fw-bold text-dark m-0">@ModuleState.Title</h4>
        </div>
    }

    <div class="card-body">
        <ModuleInstance />
    </div>
</div>

@code {
    public override string Name => "Planet Ministries Card Container";

    private bool _showTitle = true;

    protected override void OnParametersSet()
    {
        try
        {
            var ns = GetType().Namespace ?? "Ncube.Theme.PlanetMinistries.Containers";
            _showTitle = bool.Parse(SettingService.GetSetting(ModuleState.Settings, $"{ns}:Title", "true"));
        }
        catch
        {
            _showTitle = true;
        }
    }
}