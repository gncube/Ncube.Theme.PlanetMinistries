@using System.Net
@namespace Ncube.Theme.PlanetMinistries
@inherits ThemeBase
@inject NavigationManager NavigationManager
@inject ISettingService SettingService
@inject IStringLocalizer<Default> Localizer

<div class="u-wrapper d-flex flex-column min-vh-100">
    <!-- Unify Header Section -->
    <header id="js-header" class="u-header u-header--static u-shadow-v19">
        <!-- Top Bar with Search & Oqtane Controls -->
        <div class="u-header__section u-top-bar-custom py-2">
            <div class="container-fluid container-xl d-flex justify-content-between align-items-center">
                <div class="brand-logo-area d-flex align-items-center">
                    <a href="@PageState.Alias.Path" class="navbar-brand py-0">
                        @if (PageState.Site.LogoFileId is not null)
                        {
                            <img class="brand-logo-img img-fluid"
                                 src="@Utilities.FileUrl(PageState.Alias, PageState.Site.LogoFileId.Value)"
                                 alt="@PageState.Site.Name" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_logoUrl))
                        {
                            <img class="brand-logo-img img-fluid" src="@_logoUrl" alt="@PageState.Site.Name" />
                        }
                        else
                        {
                            <span class="logo-text">@PageState.Site.Name</span>
                        }
                    </a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (_search)
                    {
                        <Search AllowTextInput="false" />
                    }
                    <UserProfile />
                    <Login ShowLogin="@_login" />
                    <ControlPanel />
                </div>
            </div>
        </div>

        <!-- Main Navigation Bar -->
        <div class="u-header__section u-header__section--light py-2 border-bottom">
            <div class="container-fluid container-xl d-flex justify-content-between align-items-center">
                <NavMenu />

                @if (!string.IsNullOrEmpty(_navbuttontext) && !string.IsNullOrEmpty(_navbuttonurl))
                {
                    <div class="d-none d-lg-block">
                        <a class="btn btn-sm u-btn-primary text-uppercase" href="@_navbuttonurl">@_navbuttontext</a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Top Billboard / Hero Section -->
    @if (!string.IsNullOrEmpty(_hero))
    {
        <div class="hero-section">
            @((MarkupString)_hero)
        </div>
    }

    <div class="billboard-pane-zone">
        <Pane Name="@ThemeConstants.Panes.HeaderBillboard" />
    </div>

    @if (!PageState.Site.Settings.ContainsKey(GetType().Namespace + ":Login") &&
    UserSecurity.IsAuthorized(PageState.User, PermissionNames.Edit, PageState.Page.PermissionList))
    {
        <div class="container text-center my-3">
            <a href="@_themesettingsurl" class="btn btn-outline-primary btn-sm">Configure Theme Settings</a>
        </div>
    }

    <!-- Unify Magazine 2-Column Content Layout -->
    <main class="main-content-zone container-fluid container-xl py-4 flex-grow-1">
        <div class="row">
            <!-- Main Content Area -->
            <div class="col-lg-8 mb-4">
                <Pane Name="@ThemeConstants.Panes.MainBody" />
            </div>

            <!-- Right Sidebar Widgets -->
            <aside class="col-lg-4 mb-4">
                <Pane Name="@ThemeConstants.Panes.RightSidebar" />
            </aside>
        </div>

        <!-- Collapsible Bottom / Secondary Sidebar -->
        <div class="row">
            <div class="col-12">
                <Pane Name="@ThemeConstants.Panes.LeftSidebar" />
            </div>
        </div>
    </main>

    <!-- Bottom Features Section -->
    <div class="bottom-features-zone bg-light border-top py-4">
        <div class="container-fluid container-xl">
            <Pane Name="@ThemeConstants.Panes.BottomFeature" />
        </div>
    </div>

    <!-- Unify Magazine Footer -->
    <footer class="u-footer-main pt-5 mt-auto">
        <div class="container-fluid container-xl pb-4">
            @if (!string.IsNullOrEmpty(_footer))
            {
                @((MarkupString)_footer)
            }
            else
            {
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <h4 class="h6 text-uppercase fw-bold mb-3">@PageState.Site.Name</h4>
                        <p class="small">Publishing, ministry resources, and community updates.</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h4 class="h6 text-uppercase fw-bold mb-3">Quick Links</h4>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-1"><a href="@NavigateUrl()"><i class="fa fa-angle-right me-1 text-primary"></i>
                                Home</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h4 class="h6 text-uppercase fw-bold mb-3">Follow Us</h4>
                            <div class="d-flex gap-3 fs-5">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-youtube"></i></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="u-footer-bottom py-3">
                <div class="container-fluid container-xl text-center small text-muted">
                    @((MarkupString)_footerCopy)
                </div>
            </div>
        </footer>
    </div>

    <CookieConsent />

    <!-- Go-To Top Anchor -->
    <a href="@NavigateUrl()" id="scroll-top" class="u-go-to-v2" aria-label="Back to top">
        <i class="fa fa-angle-up"></i>
    </a>

@code {
    public override string Name => "Default";
    public override string Panes => ThemeConstants.Panes.Default;

    private bool _login = true;
    private bool _search = true;
    private string _navbuttontext = string.Empty;
    private string _navbuttonurl = string.Empty;
    private string _hero = string.Empty;
    private string _footer = string.Empty;
    private string _themesettingsurl = string.Empty;
    private string _logoUrl = string.Empty;
    private string _footerCopy = string.Empty;

    protected override void OnParametersSet()
    {
        try
        {
            var ns = GetType().Namespace ?? "Ncube.Theme.PlanetMinistries";

            _hero = SettingService.GetSetting(PageState.Page.Settings, $"{ns}:Hero", string.Empty);
            if (!string.IsNullOrEmpty(_hero))
            {
                _hero = Utilities.FormatContent(_hero, PageState.Alias, "render");
            }

            _login = bool.Parse(SettingService.GetSetting(PageState.Site.Settings, $"{ns}:Login", "True"));
            _search = bool.Parse(SettingService.GetSetting(PageState.Site.Settings, $"{ns}:Search", "True"));
            _navbuttontext = SettingService.GetSetting(PageState.Site.Settings, $"{ns}:NavButtonText", string.Empty);
            _navbuttonurl = SettingService.GetSetting(PageState.Site.Settings, $"{ns}:NavButtonUrl", string.Empty);
            _footer = SettingService.GetSetting(PageState.Site.Settings, $"{ns}:Footer", string.Empty);
            if (!string.IsNullOrEmpty(_footer))
            {
                _footer = Utilities.FormatContent(_footer, PageState.Alias, "render");
            }

            _logoUrl = SettingService.GetSetting(PageState.Site.Settings, ThemeConstants.BrandLogoUrlSetting, string.Empty);
            _footerCopy = SettingService.GetSetting(
                PageState.Site.Settings,
                ThemeConstants.BrandFooterCopySetting,
                $"&copy; {DateTime.UtcNow.Year} {PageState.Site.Name}. All rights reserved.");

            if (PageState.Site.Settings.TryGetValue(Constants.PageManagementModule, out var managementModuleId) &&
                int.TryParse(managementModuleId, out var moduleId))
            {
                _themesettingsurl = Utilities.EditUrl(
                    PageState.Alias.Path,
                    "admin/pages",
                    moduleId,
                    "edit",
                    $"id={PageState.Page.PageId}&tab=ThemeSettings&returnurl={WebUtility.UrlEncode(PageState.Route.PathAndQuery)}");
            }
        }
        catch
        {
            _footerCopy = $"&copy; {DateTime.UtcNow.Year} {PageState.Site.Name}. All rights reserved.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        var interop = new Interop(JSRuntime);
        await interop.Load();
    }
}