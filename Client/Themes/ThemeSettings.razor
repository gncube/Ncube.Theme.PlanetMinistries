@namespace Ncube.Theme.PlanetMinistries
@inherits ModuleBase
@implements Oqtane.Interfaces.ISettingsControl
@inject ISettingService SettingService
@inject IStringLocalizer<Default> Localizer
@attribute [OqtaneIgnore]

<div class="container">
    <div class="row mb-2 align-items-center">
        <Label Class="col-sm-3" For="login" HelpText="Specify if a Login option should be displayed. Note that this option does not prevent the login page from being accessible via a direct url.">Show Login?</Label>
        <div class="col-sm-9">
            <select id="login" class="form-select" @bind="@_login">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
        </div>
    </div>
    <div class="row mb-2 align-items-center">
        <Label Class="col-sm-3" For="search" HelpText="Specify if a search icon should be displayed">Show Search?</Label>
        <div class="col-sm-9">
            <select id="search" class="form-select" @bind="@_search">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
        </div>
    </div>
    <div class="row mb-2 align-items-center">
        <Label Class="col-sm-3" For="navbutton" HelpText="Specify if you wish to include a button in the navigation for this site">Nav Button?</Label>
        <div class="col-sm-9">
            <select id="navbutton" class="form-select mb-2" @bind="@_navbutton">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
            @if (_navbutton == "True")
            {
                <div class="d-flex flex-column gap-2">
                    <input id="navbuttoncode" class="form-control" placeholder="Button Text" @bind="@_navbuttontext" />
                    <input id="navbuttonurl" class="form-control" placeholder="Button Url" @bind="@_navbuttonurl" />
                </div>
            }
        </div>
    </div>
    <div class="row mb-2 align-items-center">
        <Label Class="col-sm-3" For="footerHTML" HelpText="Specify if you wish to include a custom footer section for this site">Footer Section?</Label>
        <div class="col-sm-9">
            <select id="footerHTML" class="form-select mb-2" value="@_footer" @onchange="FooterChanged">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
            @if (_footer == "True")
            {
                <textarea id="footerHTMLText" class="form-control" @bind="@_footerHTML" rows="5"></textarea>
            }
        </div>
    </div>
    <hr />
    <div class="row mb-2 align-items-center">
        <Label Class="col-sm-3" For="heroHTML" HelpText="Specify if you wish to include a hero banner for this page">Hero Banner?</Label>
        <div class="col-sm-9">
            <select id="heroHTML" class="form-select mb-2" value="@_hero" @onchange="HeroChanged">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
            @if (_hero == "True")
            {
                <textarea id="heroHTMLText" class="form-control" @bind="@_heroHTML" rows="5"></textarea>
            }
        </div>
    </div>
    <div class="row mb-2 align-items-center">
        <Label Class="col-sm-3" For="layout" HelpText="Specify the default layout for the page content">Content Layout:</Label>
        <div class="col-sm-9">
            <select id="layout" class="form-select" @bind="@_layout">
                <option value="standard">Standard Width</option>
                <option value="full">Full Width</option>
            </select>
        </div>
    </div>
</div>

@code {
    private int _pageId = -1;
    private string _login = "True";
    private string _search = "True";
    private string _navbutton = "False";
    private string _navbuttontext = string.Empty;
    private string _navbuttonurl = string.Empty;
    private string _hero = "False";
    private string _heroHTML = string.Empty;
    private string _layout = "standard";
    private string _footer = "False";
    private string _footerHTML = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (PageState.QueryString.TryGetValue("id", out var idStr) && int.TryParse(idStr, out var id))
            {
                _pageId = id;
            }
            await LoadSettings();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Settings {Error}", ex.Message);
            AddModuleMessage("Error Loading Settings", MessageType.Error);
        }
    }

    private async Task LoadSettings()
    {
        var ns = GetType().Namespace ?? "Ncube.Theme.PlanetMinistries";

        // Page settings
        var pageSettings = await SettingService.GetPageSettingsAsync(_pageId);
        _heroHTML = SettingService.GetSetting(pageSettings, $"{ns}:Hero", string.Empty);
        _hero = string.IsNullOrEmpty(_heroHTML) ? "False" : "True";
        _layout = SettingService.GetSetting(pageSettings, $"{ns}:Layout", string.Empty);
        if (string.IsNullOrEmpty(_layout))
        {
            _layout = (_hero == "False") ? "standard" : "full";
        }

        // Site settings
        var siteSettings = PageState.Site.Settings;
        _login = SettingService.GetSetting(siteSettings, $"{ns}:Login", "True");
        _search = SettingService.GetSetting(siteSettings, $"{ns}:Search", "True");
        _navbuttontext = SettingService.GetSetting(siteSettings, $"{ns}:NavButtonText", string.Empty);
        _navbuttonurl = SettingService.GetSetting(siteSettings, $"{ns}:NavButtonUrl", string.Empty);
        _navbutton = (!string.IsNullOrEmpty(_navbuttontext) && !string.IsNullOrEmpty(_navbuttonurl)) ? "True" : "False";
        _footerHTML = SettingService.GetSetting(siteSettings, $"{ns}:Footer", string.Empty);
        _footer = string.IsNullOrEmpty(_footerHTML) ? "False" : "True";
    }

    private void HeroChanged(ChangeEventArgs eventArgs)
    {
        _hero = eventArgs.Value?.ToString() ?? "False";
        if (bool.TryParse(_hero, out var isHero) && isHero)
        {
            if (string.IsNullOrEmpty(_heroHTML))
            {
                _heroHTML = Localizer["Hero"];
            }
            _layout = "full";
        }
        else
        {
            _heroHTML = string.Empty;
            _layout = "standard";
        }
    }

    private void FooterChanged(ChangeEventArgs eventArgs)
    {
        _footer = eventArgs.Value?.ToString() ?? "False";
        if (bool.TryParse(_footer, out var isFooter) && isFooter)
        {
            if (string.IsNullOrEmpty(_footerHTML))
            {
                _footerHTML = Localizer["Footer"];
            }
        }
        else
        {
            _footerHTML = string.Empty;
        }
    }

    public async Task UpdateSettings()
    {
        try
        {
            var ns = GetType().Namespace ?? "Ncube.Theme.PlanetMinistries";

            // Save page settings
            var pageSettings = await SettingService.GetPageSettingsAsync(_pageId);
            pageSettings = SettingService.SetSetting(pageSettings, $"{ns}:Hero", _heroHTML);
            pageSettings = SettingService.SetSetting(pageSettings, $"{ns}:Layout", _layout);
            await SettingService.UpdatePageSettingsAsync(pageSettings, _pageId);

            // Save site settings
            var siteSettings = await SettingService.GetSiteSettingsAsync(PageState.Site.SiteId);
            siteSettings = SettingService.SetSetting(siteSettings, $"{ns}:Login", _login);
            siteSettings = SettingService.SetSetting(siteSettings, $"{ns}:Search", _search);
            siteSettings = SettingService.SetSetting(siteSettings, $"{ns}:NavButtonText", _navbuttontext);
            siteSettings = SettingService.SetSetting(siteSettings, $"{ns}:NavButtonUrl", _navbuttonurl);
            siteSettings = SettingService.SetSetting(siteSettings, $"{ns}:Footer", _footerHTML);
            await SettingService.UpdateSiteSettingsAsync(siteSettings, PageState.Site.SiteId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Settings {Error}", ex.Message);
            AddModuleMessage("Error Saving Settings", MessageType.Error);
        }
    }
}