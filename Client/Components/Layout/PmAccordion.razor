@namespace Ncube.Theme.PlanetMinistries.Client.Components.Layout

<div class="accordion @(Flush ? "accordion-flush" : string.Empty) @Class" id="@AccordionId">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter]
    public string AccordionId { get; set; } = $"pm-accordion-{Guid.NewGuid():N}";

    [Parameter]
    public bool Flush { get; set; }

    [Parameter]
    public bool AlwaysOpen { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}