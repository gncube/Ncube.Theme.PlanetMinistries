@namespace Ncube.Theme.PlanetMinistries.Client.Components.Layout

<div class="accordion-item">
    <h2 class="accordion-header" id="@HeaderId">
        <button class="accordion-button @(!_isOpen ? "collapsed" : string.Empty)" type="button"
                aria-expanded="@(_isOpen ? "true" : "false")" aria-controls="@CollapseId" @onclick="Toggle">
            @Title
        </button>
    </h2>
    <div id="@CollapseId" class="accordion-collapse collapse @(_isOpen ? "show" : string.Empty)"
         aria-labelledby="@HeaderId" data-bs-parent="@ParentSelector">
        <div class="accordion-body">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public PmAccordion? Parent { get; set; }

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public bool InitiallyExpanded { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private readonly string _itemId = Guid.NewGuid().ToString("N");
    private bool _isOpen;

    private string HeaderId => $"heading-{_itemId}";
    private string CollapseId => $"collapse-{_itemId}";
    private string? ParentSelector => (Parent is not null && !Parent.AlwaysOpen) ? $"#{Parent.AccordionId}" : null;

    protected override void OnInitialized()
    {
        _isOpen = InitiallyExpanded;
    }

    private void Toggle() => _isOpen = !_isOpen;
}