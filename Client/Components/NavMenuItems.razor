@namespace Ncube.Theme.PlanetMinistries
@inherits MenuItemsBase

<ul class="@(ParentPage is null ? "d-flex align-items-center mb-0 list-unstyled gap-2" : "dropdown-menu u-dropdown-menu shadow-sm border-0")">
    @foreach (var childPage in GetChildPages())
    {
        var attributes = new Dictionary<string, object>
        {
            ["href"] = GetUrl(childPage)
        };

        var target = GetTarget(childPage);
        if (!string.IsNullOrEmpty(target))
        {
            attributes["target"] = target;
        }

        var isCurrent = childPage.PageId == PageState.Page.PageId;

        if (!childPage.HasChildren)
        {
            if (childPage.Level == 0)
            {
                <li class="nav-item u-nav-item">
                    <a class="nav-link u-nav-link @(isCurrent ? "active" : string.Empty)" @attributes="attributes">
                        @childPage.Name
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a class="dropdown-item u-dropdown-item @(isCurrent ? "active" : string.Empty)" @attributes="attributes">
                        @childPage.Name
                    </a>
                </li>
            }
        }
        else
        {
            <li class="nav-item dropdown u-nav-item @(isCurrent ? "active" : string.Empty)">
                <a class="nav-link dropdown-toggle u-nav-link d-flex align-items-center justify-content-between" @attributes="attributes" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span>@childPage.Name</span>
                    <i class="bi bi-chevron-down ms-1 small toggle-dropdown"></i>
                </a>
                <NavMenuItems ParentPage="childPage" Pages="Pages" />
            </li>
        }
    }
</ul>