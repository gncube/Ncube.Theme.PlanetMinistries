@namespace Ncube.Theme.PlanetMinistries
@inherits MenuItemsBase

<ul
    class="@(ParentPage is null ? "navbar-nav d-flex flex-row flex-wrap gap-2 mb-0 list-unstyled" : "dropdown-menu u-shadow-v11 border-top border-primary border-2")">
    @foreach (var childPage in GetChildPages())
    {
        var attributes = new Dictionary<string, object>
        {
            ["href"] = GetUrl(childPage)
        };

        var target = GetTarget(childPage);
        if (!string.IsNullOrEmpty(target))
        {
            attributes["target"] = target;
        }

        var isCurrent = childPage.PageId == PageState.Page.PageId;

        if (!childPage.HasChildren)
        {
            if (childPage.Level == 0)
            {
                <li class="nav-item">
                    <a class="nav-link text-uppercase fw-semibold px-2 @(isCurrent ? "text-primary" : "")" @attributes="attributes">
                        @childPage.Name
                    </a>
                </li>
            }
            else
            {
                <li class="dropdown-item">
                    <a class="nav-link py-1 @(isCurrent ? "text-primary" : "")" @attributes="attributes">
                        @childPage.Name
                    </a>
                </li>
            }
        }
        else
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-uppercase fw-semibold px-2 @(isCurrent ? "text-primary" : "")"
                   @attributes="attributes" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span>@childPage.Name</span>
                    <i class="fa fa-angle-down ms-1 small"></i>
                </a>
                <NavMenuItems ParentPage="childPage" Pages="Pages" />
            </li>
        }
    }
</ul>