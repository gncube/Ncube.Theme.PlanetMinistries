@namespace Ncube.Theme.PlanetMinistries
@inherits ThemeBase
@inject ISettingService SettingService

<div class="u-wrapper d-flex flex-column min-vh-100">
    <div class="u-top-bar py-2">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="u-top-contacts d-flex gap-3">
                <span><i class="fa fa-envelope me-1"></i> contact@planetministries.org</span>
            </div>
            <div class="u-top-auth d-flex align-items-center gap-2">
                <UserProfile />
                <Login />
                <ControlPanel />
            </div>
        </div>
    </div>

    <header class="u-header-main py-3 sticky-top">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="brand-identity">
                @if (!string.IsNullOrWhiteSpace(_logoUrl))
                {
                    <a href="@NavigateUrl()">
                        <img src="@_logoUrl" alt="@PageState.Site.Name" class="brand-logo-img" />
                    </a>
                }
                else
                {
                    <div class="logo-text">
                        <a href="@NavigateUrl()">@PageState.Site.Name</a>
                    </div>
                }
            </div>

            <nav class="main-navbar">
                <NavMenu />
            </nav>
        </div>
    </header>

    <div class="billboard-pane-zone">
        <Pane Name="@ThemeConstants.Panes.HeaderBillboard" />
    </div>

    <main class="main-content-zone container-fluid px-lg-5 py-4 flex-grow-1">
        <Pane Name="@ThemeConstants.Panes.MainBody" />
    </main>

    <div class="bottom-features-zone bg-light border-top">
        <Pane Name="@ThemeConstants.Panes.BottomFeature" />
    </div>

    <footer class="u-footer pt-5 mt-auto">
        <div class="container pb-4">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h5 class="text-white mb-3">@PageState.Site.Name</h5>
                    <p class="small">Full-width publishing and responsive landing layout.</p>
                </div>
                <div class="col-md-6 mb-4 text-md-end">
                    <h5 class="text-white mb-3">Follow Us</h5>
                    <div class="d-flex gap-3 justify-content-md-end">
                        <a href="#" class="fs-5"><i class="fa fa-facebook"></i></a>
                        <a href="#" class="fs-5"><i class="fa fa-twitter"></i></a>
                        <a href="#" class="fs-5"><i class="fa fa-youtube-play"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="u-footer-copyright py-3">
            <div class="container text-center small">
                @((MarkupString)_footerCopy)
            </div>
        </div>
    </footer>
</div>

@code {
    public override string Name => "Full Width";
    public override string Panes => ThemeConstants.Panes.FullWidth;

    private string _logoUrl = string.Empty;
    private string _footerCopy = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var siteSettings = await SettingService.GetSiteSettingsAsync(PageState.Site.SiteId);
            _logoUrl = SettingService.GetSetting(siteSettings, ThemeConstants.BrandLogoUrlSetting, string.Empty);
            _footerCopy = SettingService.GetSetting(
                siteSettings,
                ThemeConstants.BrandFooterCopySetting,
                $"&copy; {DateTime.UtcNow.Year} {PageState.Site.Name}. All rights reserved.");
        }
        catch
        {
            _logoUrl = string.Empty;
            _footerCopy = $"&copy; {DateTime.UtcNow.Year} Planet Ministries. All rights reserved.";
        }
    }
}